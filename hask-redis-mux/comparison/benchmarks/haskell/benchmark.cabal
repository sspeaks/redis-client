cabal-version:      3.0
name:               redis-benchmark
version:            0.1.0.0
synopsis:           Benchmark suite for hask-redis-mux
license:            MIT
build-type:         Simple

executable redis-benchmark
    default-language: GHC2021
    main-is:          Main.hs
    ghc-options:      -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N -s"
    build-depends:    base >=4.19 && <4.22
                    , hask-redis-mux
                    , bytestring >=0.12 && <0.13
                    , clock >=0.8 && <0.9
